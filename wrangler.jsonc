{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gloria-qi",
  "main": "worker/index.js",
  "compatibility_date": "2026-05-12",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Only /api/* runs the Worker; everything else is served as a static file.
    "run_worker_first": ["/api/*"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Cloud fallback for the chat when the Mac is off (Workers AI free tier).
  "ai": {
    "binding": "AI"
  },
  // The latest "what I'm doing now" summary, posted by local/now-sync.mjs.
  // No id: wrangler creates the namespace on first deploy.
  "kv_namespaces": [
    { "binding": "NOW" }
  ],
  // 10 chat messages per visitor IP per minute.
  "ratelimits": [
    {
      "name": "CHAT_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  // Secrets (set with `npx wrangler secret put <NAME>`, never committed):
  //   LOCAL_LLM_URL, LOCAL_LLM_KEY, CF_ACCESS_ID, CF_ACCESS_SECRET, NOW_TOKEN
  // See docs/local-model.md.
  "vars": {
    "LOCAL_LLM_MODEL": "",
    "FALLBACK_MODEL": "@cf/qwen/qwen3-30b-a3b-fp8"
  }
}
